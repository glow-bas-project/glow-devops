# Required: copy to compose/.env (gitignored).
#   cp compose/.env.example compose/.env
# Used by scripts/compose-up.sh, ensure-postgres.sh, and glowBuild (Gradle plugin).

# Container registry (compose image defaults)
REGISTRY_PREFIX=registry.gitlab.au.dk/backend-architecture-and-scalability
IMAGE_TAG=latest

# Shared Postgres (glow-postgres + Keycloak DB + service JDBC users)
POSTGRES_USER=glow
POSTGRES_PASSWORD=glow

# Edge proxy (glow-traefik) — HTTP only
TRAEFIK_HTTP_PORT=80
GLOW_EDGE_HOST=localhost
GLOW_AUTH_PATH=/auth
# Public frontend URL (full URL incl. path — KC_HOSTNAME + realm JSON placeholders)
authBaseUrl=http://localhost/auth
authAdminUrl=http://localhost/auth/admin

# OIDC for services (run ./scripts/ensure-oidc-secrets.sh to generate real values)
GLOW_USER_OIDC_CLIENT_SECRET=*placeholder*
GLOW_RESTAURANT_OIDC_CLIENT_SECRET=*placeholder*
GLOW_ORDER_OIDC_CLIENT_SECRET=*placeholder*
GLOW_CART_OIDC_CLIENT_SECRET=*placeholder*
GLOW_COURIER_OIDC_CLIENT_SECRET=*placeholder*
GLOW_MENU_OIDC_CLIENT_SECRET=*placeholder*
GLOW_PAYMENT_OIDC_CLIENT_SECRET=*placeholder*
